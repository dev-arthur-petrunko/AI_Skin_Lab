# AI Skin Lab — environment configuration (used by docker-compose)

# OpenAI credentials for the AI consultant.
# Leave empty to run in fallback mode (keyword search, canned reply text).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Frontend CORS / allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# Automatically fill missing ru/en cells in price.xlsx on every catalog reload.
# Network calls (MyMemory) — keep 0 unless you really need it.
AUTO_TRANSLATE=0

# Shared secret for GET /admin/reload and GET /admin/translate
# (sent as the X-Admin-Token header). Leave empty to disable both endpoints.
ADMIN_TOKEN=

# Optional overrides — defaults are derived from the project location.
# docker-compose sets the container paths itself, so these are only needed
# for a non-Docker run with a non-default layout.
#EXCEL_PATH=./data/price.xlsx
#IMAGES_DIR=./data/images
